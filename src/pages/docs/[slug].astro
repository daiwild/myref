---
import 'katex/dist/katex.min.css';
import 'highlight.js/styles/github-dark.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FavoriteButton from '../../components/FavoriteButton.astro';
import DocIcon from '../../components/DocIcon.astro';
import { renderMarkdown } from '../../lib/markdown';
import { getDocMeta } from '../../lib/index';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const docsDir = path.join(process.cwd(), 'docs');
  return fs
    .readdirSync(docsDir)
    .filter((file) => file.endsWith('.md'))
    .sort()
    .map((file) => {
      const slug = file.replace(/\.md$/, '');
      return {
        params: { slug },
        props: { slug, content: fs.readFileSync(path.join(docsDir, file), 'utf8') },
      };
    });
}

const { slug, content } = Astro.props;
const meta = getDocMeta(slug);
const { html, headings } = await renderMarkdown(content);
const title = meta?.title || extractFallbackTitle(content, slug);

function extractFallbackTitle(content: string, slug: string): string {
  const match = content.match(/^\s*([^\n]+?)\s*\n=+\s*$/m);
  return match ? match[1].trim() : slug;
}
---
<BaseLayout title={`${title} · MyRef`} description={meta?.intro}>
  <nav class="breadcrumb">
    <a href="/">首页</a>
    <span>/</span>
    <span>{meta?.category || '未分类'}</span>
    <span>/</span>
    <span>{title}</span>
  </nav>
  <div class="doc-layout">
    <article class="doc-main">
      <header class="doc-header">
        <DocIcon slug={slug} size="header" />
        <h1>{title}</h1>
        {meta?.intro && <p class="doc-intro">{meta.intro}</p>}
        <FavoriteButton slug={slug} title={title} icon={slug} variant="header" />
      </header>
      <div class="markdown-body" set:html={html} />
    </article>
    {headings.length > 0 && (
      <aside class="doc-toc">
        <h2>目录</h2>
        <nav>
          {headings.map((heading) => (
            <a class:list={['toc-item', `toc-level-${heading.depth}`]} href={`#${heading.slug}`}>
              {heading.text}
            </a>
          ))}
        </nav>
      </aside>
    )}
  </div>
  <script>
    document.querySelectorAll<HTMLPreElement>('.markdown-body pre').forEach((pre) => {
      if (pre.querySelector('.copy-btn')) return;
      const code = pre.querySelector('code');
      if (!code) return;
      const btn = document.createElement('button');
      btn.className = 'copy-btn';
      btn.type = 'button';
      btn.textContent = '复制';
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code.innerText);
          btn.textContent = '已复制';
        } catch {
          btn.textContent = '复制失败';
        }
        window.setTimeout(() => (btn.textContent = '复制'), 1500);
      });
      pre.appendChild(btn);
    });
  </script>
</BaseLayout>
